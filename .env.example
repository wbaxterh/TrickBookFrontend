# Google Maps (used in app.config.js)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Or use EXPO_PUBLIC_ prefix for client-side access
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Sentry (optional). Leave empty to disable. The native module links through
# prebuild, so a new EAS build is required before native crashes are captured.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=production

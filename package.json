{
  "name": "trickbook",
  "version": "2.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "validate": "biome check . && tsc --noEmit",
    "check:prod": "bash scripts/check-prod-ready.sh",
    "postinstall": "patch-package",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo/config-plugins": "~54.0.4",
    "@hookform/resolvers": "^5.2.2",
    "@pixiv/three-vrm": "3.5.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.10.1",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.11.0",
    "@react-three/fiber": "9.6.1",
    "@tanstack/react-query": "^5.90.20",
    "apisauce": "^1.1.1",
    "axios": "^1.13.3",
    "clsx": "^2.1.1",
    "expo": "^54.0.0",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.13",
    "expo-auth-session": "~7.0.10",
    "expo-av": "~16.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.21",
    "expo-gl": "~16.0.10",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.22",
    "expo-screen-orientation": "~9.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-speech-recognition": "3.1.3",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "expo-video": "~3.0.15",
    "expo-web-browser": "~15.0.10",
    "form-data": "^4.0.4",
    "formik": "^2.2.9",
    "jotai": "^1.11.2",
    "jwt-decode": "^3.1.2",
    "nativewind": "^4.2.1",
    "patch-package": "^8.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.71.1",
    "react-native": "0.81.5",
    "react-native-audio-api": "0.13.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-safe-area-view": "^1.1.1",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "^13.16.0",
    "react-native-worklets": "0.5.1",
    "react-native-worklets-core": "^1.6.2",
    "socket.io-client": "^4.8.3",
    "supercluster": "^8.0.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.3.2",
    "three": "0.170.0",
    "typescript": "~5.9.2",
    "yup": "^0.32.11",
    "zod": "^3.25.76",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@babel/core": "^7.12.9",
    "@biomejs/biome": "^2.3.14",
    "@types/react": "~19.1.10",
    "@types/three": "^0.170.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  },
  "private": true,
  "lint-staged": {
    "*.{ts,tsx}": [
      "biome check --write",
      "biome format --write"
    ],
    "*.{json,css}": [
      "biome format --write"
    ]
  }
}
